# Database (relative paths are resolved from the project folder)
AI_DATABASE_PATH=data/ai_interviewer.db
AUTO_SEED_DEMO=true

# auto: try Ollama, then fall back to deterministic rubric matching
# ollama: prefer Ollama but still fall back if it is unavailable
# rule: never call Ollama
EVALUATOR_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EVALUATOR_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=30m

# Local speech-to-text. "auto" selects validated medium/CUDA, medium/CPU or small/CPU.
# To force a profile, replace all three values (for example: small/cpu/int8).
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_DOWNLOAD_ROOT=models/whisper

# auto: use local Ollama when available; off: keep the raw Whisper transcript.
TRANSCRIPT_CORRECTION_MODE=auto
STT_MIN_CONFIDENCE=0.48
# Must match the browser's pre-recording noise gate. Less negative is noisier.
STT_MAX_AMBIENT_NOISE_DBFS=-28

MAX_UPLOAD_MB=25
