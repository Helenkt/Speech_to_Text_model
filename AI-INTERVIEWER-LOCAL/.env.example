# Database (relative paths are resolved from the project folder)
AI_DATABASE_PATH=data/ai_interviewer.db
AUTO_SEED_DEMO=true

# auto: try Ollama, then fall back to deterministic rubric matching
# ollama: prefer Ollama but still fall back if it is unavailable
# rule: never call Ollama
EVALUATOR_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_EVALUATOR_TIMEOUT_SECONDS=20
OLLAMA_CORRECTION_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=30m
# Model mạnh hơn dùng riêng cho sinh câu hỏi có cấu trúc.
QUESTION_GENERATION_MODEL=qwen3:8b

# Local speech-to-text. "auto" selects validated medium/CUDA, medium/CPU or small/CPU.
# auto | low | balanced | performance | high_accuracy
# Keep auto for hardware detection. A forced profile is still downgraded if CUDA is absent.
RUNTIME_PROFILE=auto
# To force a profile, replace all three values (for example: small/cpu/int8).
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_DOWNLOAD_ROOT=models/whisper
# Model mạnh chỉ chạy theo yêu cầu khi Giáo viên mở phần chấm lại.
REVIEW_WHISPER_MODEL=large-v3
# auto giữ model trong RAM chỉ khi máy còn đủ tài nguyên; keep/release để ép hành vi.
REVIEW_MODEL_CACHE_POLICY=auto

# auto: use local Ollama when available; off: keep the raw Whisper transcript.
TRANSCRIPT_CORRECTION_MODE=auto
STT_MIN_CONFIDENCE=0.48
# Must match the browser's pre-recording noise gate. Less negative is noisier.
STT_MAX_AMBIENT_NOISE_DBFS=-28

# Lưu voice gốc và đưa bài dưới ngưỡng này vào hàng chờ Giáo viên.
AUDIO_STORAGE_DIR=data/audio
TEACHER_REVIEW_SCORE_THRESHOLD=50

MAX_UPLOAD_MB=25
# Tự đóng phiên luyện tập bị bỏ quên sau số giờ này.
ACTIVE_SESSION_TTL_HOURS=24
