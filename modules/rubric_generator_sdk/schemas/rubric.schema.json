{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "fact_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Fact Key",
          "type": "string"
        },
        "expected_claim": {
          "minLength": 1,
          "title": "Expected Claim",
          "type": "string"
        },
        "requirement_quote": {
          "minLength": 1,
          "title": "Requirement Quote",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceQuote"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "importance": {
          "maximum": 10,
          "minimum": 1,
          "title": "Importance",
          "type": "integer"
        },
        "accepted_meanings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Accepted Meanings",
          "type": "array"
        },
        "misconceptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Misconceptions",
          "type": "array"
        },
        "evidence_requirement": {
          "minLength": 1,
          "title": "Evidence Requirement",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/Level"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Levels",
          "type": "array"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "max_points_units": {
          "minimum": 1,
          "title": "Max Points Units",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "task_id",
        "fact_key",
        "expected_claim",
        "requirement_quote",
        "sources",
        "importance",
        "accepted_meanings",
        "misconceptions",
        "evidence_requirement",
        "verification",
        "levels",
        "critical",
        "max_points_units"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Level": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "points_units": {
          "minimum": 0,
          "title": "Points Units",
          "type": "integer"
        },
        "descriptor": {
          "minLength": 1,
          "title": "Descriptor",
          "type": "string"
        }
      },
      "required": [
        "id",
        "points_units",
        "descriptor"
      ],
      "title": "Level",
      "type": "object"
    },
    "QuestionType": {
      "enum": [
        "DEFINITION",
        "COMPARISON",
        "EXPLANATION",
        "PROCEDURE",
        "ENUMERATION",
        "APPLICATION",
        "ANALYSIS"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "object": {
          "minLength": 1,
          "title": "Object",
          "type": "string"
        },
        "negated": {
          "title": "Negated",
          "type": "boolean"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object",
        "negated",
        "conditions"
      ],
      "title": "Relation",
      "type": "object"
    },
    "ScoredTask": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "question_quote": {
          "minLength": 1,
          "title": "Question Quote",
          "type": "string"
        },
        "primary_type": {
          "$ref": "#/$defs/QuestionType"
        },
        "secondary_types": {
          "items": {
            "$ref": "#/$defs/QuestionType"
          },
          "title": "Secondary Types",
          "type": "array"
        },
        "reference_quotes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Reference Quotes",
          "type": "array"
        },
        "importance": {
          "maximum": 10,
          "minimum": 1,
          "title": "Importance",
          "type": "integer"
        },
        "coverage": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "CONFLICT"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "coverage_note": {
          "minLength": 1,
          "title": "Coverage Note",
          "type": "string"
        },
        "max_points_units": {
          "minimum": 1,
          "title": "Max Points Units",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "text",
        "question_quote",
        "primary_type",
        "secondary_types",
        "reference_quotes",
        "importance",
        "coverage",
        "coverage_note",
        "max_points_units"
      ],
      "title": "ScoredTask",
      "type": "object"
    },
    "SourceQuote": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "question",
            "reference_answer"
          ],
          "title": "Source",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source",
        "quote"
      ],
      "title": "SourceQuote",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "SEMANTIC_ENTAILMENT",
            "RELATION",
            "CAUSAL",
            "DEPENDENCY",
            "SET_MATCH",
            "DOMAIN_RULE",
            "ARGUMENT"
          ],
          "title": "Method",
          "type": "string"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "causal_edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Causal Edges",
          "type": "array"
        },
        "required_steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Steps",
          "type": "array"
        },
        "precedence_edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Precedence Edges",
          "type": "array"
        },
        "expected_items": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Items",
          "type": "array"
        },
        "rule_description": {
          "title": "Rule Description",
          "type": "string"
        },
        "argument_requirements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Argument Requirements",
          "type": "array"
        }
      },
      "required": [
        "method",
        "relations",
        "causal_edges",
        "required_steps",
        "precedence_edges",
        "expected_items",
        "rule_description",
        "argument_requirements"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "rubric_version": {
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "question_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "title": "Question Id",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "reference_answer": {
      "minLength": 1,
      "title": "Reference Answer",
      "type": "string"
    },
    "question_types": {
      "items": {
        "$ref": "#/$defs/QuestionType"
      },
      "minItems": 1,
      "title": "Question Types",
      "type": "array"
    },
    "is_composite": {
      "title": "Is Composite",
      "type": "boolean"
    },
    "total_units": {
      "minimum": 1,
      "title": "Total Units",
      "type": "integer"
    },
    "units_per_point": {
      "const": 100,
      "title": "Units Per Point",
      "type": "integer"
    },
    "weight_source": {
      "enum": [
        "AUTO_PROPOSED",
        "TEACHER_CONFIGURED"
      ],
      "title": "Weight Source",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/ScoredTask"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "policy": {
      "const": "EVIDENCE_REQUIRED_NO_KEYWORD_SCORING_NO_DOUBLE_COUNT_UNCERTAIN_REVIEW",
      "title": "Policy",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "rubric_version",
    "question_id",
    "question",
    "reference_answer",
    "question_types",
    "is_composite",
    "total_units",
    "units_per_point",
    "weight_source",
    "tasks",
    "criteria",
    "policy"
  ],
  "title": "Rubric",
  "type": "object"
}
