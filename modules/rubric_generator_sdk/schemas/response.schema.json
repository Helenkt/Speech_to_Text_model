{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "model_calls_total": {
          "default": 0,
          "title": "Model Calls Total",
          "type": "integer"
        },
        "new_model_calls": {
          "default": 0,
          "title": "New Model Calls",
          "type": "integer"
        }
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Api Schema Version",
      "type": "string"
    },
    "package_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Package Version",
      "type": "string"
    },
    "engine_version": {
      "const": "1.5.0-task-source-scope",
      "default": "1.5.0-task-source-scope",
      "title": "Engine Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT_READY",
        "NEEDS_REVIEW",
        "INVALID_INPUT",
        "ERROR",
        "BUSY",
        "INTERRUPTED"
      ],
      "title": "Status",
      "type": "string"
    },
    "question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Id"
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "rubric": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rubric"
    },
    "rubric_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rubric Sha256"
    },
    "quality_report": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Report"
    },
    "review_status": {
      "default": "NOT_AVAILABLE",
      "enum": [
        "PENDING",
        "NOT_AVAILABLE"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "human_approved": {
      "const": false,
      "default": false,
      "title": "Human Approved",
      "type": "boolean"
    },
    "production_ready": {
      "const": false,
      "default": false,
      "title": "Production Ready",
      "type": "boolean"
    },
    "model_tag": {
      "title": "Model Tag",
      "type": "string"
    },
    "model_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Digest"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status",
    "model_tag"
  ],
  "title": "GenerationResponse",
  "type": "object"
}
